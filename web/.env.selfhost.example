# Independent self-hosted installation. See README.md.
# Copy to .env.local with: npm run setup:selfhost
NEXT_PUBLIC_SELF_HOSTED=true
NEXT_PUBLIC_PAYWALL_ENABLED=false
NEXT_TELEMETRY_DISABLED=1

# Required for built-in movie/show catalogs and metadata: your TMDB API v3 key.
# Server-only. Do not use a NEXT_PUBLIC_ prefix for this or OAuth secrets.
TMDB_API_KEY=

# Optional Trakt integration: register your own application.
# Client IDs are public and baked into the browser bundle at build time.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Optional Simkl integration: register your own application.
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# Optional Telegram client. These application credentials are browser-visible;
# never put a bot token, login code, password, or session string here.
NEXT_PUBLIC_TELEGRAM_API_ID=
NEXT_PUBLIC_TELEGRAM_API_HASH=

# No ARVIO-hosted backend or resolver is needed in self-hosted mode.
NEXT_PUBLIC_NETLIFY_BACKEND_URL=
NEXT_PUBLIC_ARVIO_APP_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Advanced: URL of your own compatible resolver, if you deploy one.
NEXT_PUBLIC_ARVIO_RESOLVER_URL=
NEXT_PUBLIC_ALLOW_NETLIFY_MEDIA_PROXY=false

# Server-side access to LAN home-server APIs. Off by default.
# Enable only behind authentication on a trusted private installation.
ALLOW_PRIVATE_PROXY=false

# Docker's published address. Keep loopback behind your reverse proxy.
ARVIO_BIND_ADDRESS=127.0.0.1
ARVIO_PORT=3000

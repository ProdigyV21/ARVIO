# Self-host image for `docker compose up --build` from a plain checkout of ARVIO/web.
#
# web/Dockerfile is the Unraid/CI distribution image: it also packages the exact public
# source, the codec toolchain and the runtime source bundle, all of which need CI-only inputs
# (distribution-artifacts/, pinned upstream downloads). A fresh clone has none of that, so this
# file builds the same webapp the Node quick start does and nothing else.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_SELF_HOSTED=true \
    NEXT_PUBLIC_PAYWALL_ENABLED=false \
    ARVIO_TRANSLATION_MODE=prebuilt \
    ARVIO_STANDALONE=true
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Credential-free: optional public application IDs and your TMDB key are read at runtime.
RUN npm run build && node scripts/collect-licenses.mjs

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_SELF_HOSTED=true \
    NEXT_PUBLIC_PAYWALL_ENABLED=false \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/LICENSE ./licenses/ARVIO-LICENSE
COPY --from=builder --chown=node:node /app/.next/third-party-notices ./licenses/third-party
RUN mkdir -p /app/.data/simkl-sessions /app/.data/wetrakr-sessions && chown -R node:node /app/.data && chmod 700 /app/.data
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD node -e "fetch('http://127.0.0.1:3000/version.json',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]

# For an independent installation without an ARVIO subscription, run:
#   npm run setup:selfhost
# See .env.selfhost.example and README.md for the supported self-hosting setup.
#
# The variables below are for maintainers of the hosted ARVIO service.
# Obtain credentials from the deployment environment; never commit real keys.
NEXT_PUBLIC_SELF_HOSTED=false
NEXT_PUBLIC_NETLIFY_BACKEND_URL=https://auth.arvio.tv/.netlify/functions
NEXT_PUBLIC_ARVIO_APP_ANON_KEY=
NEXT_PUBLIC_ARVIO_RESOLVER_URL=
NEXT_PUBLIC_ALLOW_NETLIFY_MEDIA_PROXY=false
NEXT_PUBLIC_PAYWALL_ENABLED=false
NEXT_PUBLIC_KOFI_URL=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
TMDB_API_KEY=
NEXT_PUBLIC_TELEGRAM_API_ID=
NEXT_PUBLIC_TELEGRAM_API_HASH=
